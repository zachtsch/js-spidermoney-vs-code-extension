{
    "name": "javascript--spidermonkey--run-button",
    "displayName": "JavaScript (SpiderMonkey) Run Button",
    "description": "Adds a run button to the top right of a .js editor.  This is similar to, but more basic, then the python extension's run button.  Also added a command palette command: Install and Setup Spidermonkey.  This install Homebrew on Macs",
    "icon": "./images/VS_Code_Extension_Icon_128x128.png",
    "version": "0.1.44",
    "publisher": "EasierTeaching",
    "engines": {
        "vscode": "^1.91.0"
    },
    "repository": {
        "url": "https://github.com/zachtsch/js-spidermoney-vs-code-extension.git"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onLanguage:javascript",
        "onLanguage:typescript"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "javascript--spidermonkey--run-button.run",
                "title": "Run This File Using JavaScript (SpiderMonkey)",
                "icon": "$(run)"
            },
            {
                "command": "javascript--spidermonkey--run-button.tsx",
                "title": "Run This File Using TypeScript (tsx)",
                "icon": "$(run)"
            },
            {
                "command": "javascript--spidermonkey--run-button.install",
                "title": "Install and Setup SpiderMonkey"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "javascript--spidermonkey--run-button.run",
                    "group": "navigation",
                    "when": "editorLangId == javascript"
                },
                {
                    "command": "javascript--spidermonkey--run-button.tsx",
                    "group": "navigation",
                    "when": "editorLangId == typescript"
                }
            ]
        },
        "snippets": [
            {
                "language": "jsonc",
                "path": "./snippets/typescript.json"
            },
            {
                "language": "css",
                "path": "./snippets/css.json"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "package:vsix": "vsce package",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.5",
        "@types/fs-extra": "^11.0.4",
        "@types/mocha": "^10.0.7",
        "@types/node": "26.x",
        "@types/vscode": "^1.91.0",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^3.9.2",
        "eslint": "^9.9.1",
        "ts-loader": "^9.6.2",
        "typescript": "^5.5.4",
        "webpack": "^5.109.2",
        "webpack-cli": "^5.1.4"
    },
    "dependencies": {
        "adm-zip": "^0.6.0",
        "fs-extra": "^11.4.0",
        "minimatch": "^10.2.4",
        "serialize-javascript": "^7.0.4"
    },
    "overrides": {
        "serialize-javascript": "^7.0.4"
    }
}

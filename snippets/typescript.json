{
  "Barebones tsconfig": {
    "prefix": ["!", "tsconfig", "web"],
    "body": [
      "{",
      "  \"compilerOptions\": {",
      "    \"target\": \"esnext\",",
      "    \"module\": \"esnext\",",
      "    \"inlineSourceMap\": true,",
      "    \"inlineSources\": true,",
      "    \"strict\": true,",
      "    \"skipLibCheck\": true",
      "  },",
      "  \"include\": [\"./*.ts\"]",
      "}",
      ""
    ],
    "description": "Barebones tsconfig.json for HTML"
  },
  "Format on save with Prettier": {
    "prefix": ["prettier", "formatonsave"],
    "body": [
      "{",
      "  \"editor.formatOnSave\": true,",
      "  \"editor.defaultFormatter\": \"esbenp.prettier-vscode\"",
      "}",
      ""
    ],
    "description": "settings.json that formats on save using the Prettier extension"
  }
}